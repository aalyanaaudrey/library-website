# Copy to .env and fill in. This file is committed; .env is not.

# --- Database (SQLite - zero setup, no server needed) ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-hex-string"
SESSION_DURATION_DAYS="30"

# --- Library rules (edit to taste) ---
LOAN_PERIOD_WEEKS="2"
MAX_ACTIVE_LOANS="5"
MAX_RENEWALS="2"
OVERDUE_FINE_PER_DAY_CENTS="50"
