# Copy to .env and fill in. This file is committed; .env is not.

# --- Database (SQLite - zero setup, no server needed) ---
DATABASE_URL="file:./dev.db"

# --- Sessions ---
# Sessions are opaque rows in the Session table, so there is no signing key
# to generate. Only DATABASE_URL is strictly required to boot.
SESSION_DURATION_DAYS="30"

# Production (e.g. a container with a persistent volume) must use an ABSOLUTE
# path, because a relative one lands in the build output and is wiped on deploy:
#   DATABASE_URL="file:/data/library.db"

# --- Library rules (edit to taste) ---
LOAN_PERIOD_WEEKS="2"
MAX_ACTIVE_LOANS="5"
MAX_RENEWALS="2"
OVERDUE_FINE_PER_DAY_CENTS="50"
