# Normalise line endings so git stops emitting
# "LF will be replaced by CRLF" warnings on every commit.
* text=auto

# Windows command scripts need CRLF to run reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell handles LF fine and it keeps the repo diff-clean across OSes.
*.ps1 text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
